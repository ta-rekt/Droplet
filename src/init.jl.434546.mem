        - # initializes species configuration from a list of presets
        - function initShape!(s::Polymer)
        0     if s.initShape == "line" || s.initShape === nothing
        0         initLine!(s.pos, s.initPos, s.boxlength, s.length)
        -     else
        0         error("Invalid string for s.initShape")
        -     end
        -     
        -     # head and tail beads
        0     s.pos[1][4] = 0
        0     s.pos[s.length][5] = 0
        -     
        0     return s
        - end
