        - 
        - # initializes empty dict of bead locations and other containers
        - function initSpecies!(s::Species)
        0     s.name = string("species", s.id)
        0     s.pos = OrderedDict{Int32, Vector{Int32}}()
        - 
        -     # head and tail beads
        0     s.head = 1
        0     s.tempVec = zeros(Int32, 3)
        0     s.nnIdxs = zeros(Int32, 6)
        0     s.freeNNs = Set{Int32}()
        - 
        0     return s
        - end
