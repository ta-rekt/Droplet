        - ######## BulkMonomer #######
        - # MARK: -BulkMonomer
        - 
        - # initializes species configuration from a list of presets
        - function initShape!(s::AbstractBulkMonomer)
        0     if s.initShape == "uniform" || s.initShape === nothing
        0         initUniform!(s.pos, s.boxlength, s.length)
        - 
        0     elseif s.initShape == "line"    
        0         initLine!(s.pos, s.initPos, s.boxlength, s.length)
        - 
        0     elseif s.initShape == "sphere"
        0         if s.initPos === nothing
        0             error("initShape='sphere' requires initPos to specify center")
        -         end
        0         if s.initParams === nothing
        0             error("initShape='sphere' requires initParams to specify radius")
        -         end
        -         
        0         _, actual_length = initSphere!(s.pos, s.initPos, s.boxlength, s.initParams)
        0         s.length = actual_length  # Update length to actual sphere size
        - 
        0     elseif s.initShape == "box"
        0         beadsPerBox = s.length
        0         totalBeads = beadsPerBox * s.initParams
        -         
        0         for i in 1:s.initParams
        0             initPos = zeros(Int32, 3)
        0             offset = div(s.boxlength, 2 * s.initParams)
        -             
        0             if !(s.initPos === nothing)
        0                 initPos[1] = s.initPos[1] + offset * (2 * i - s.initParams - 1)
        0                 initPos[2] = s.initPos[2]
        0                 initPos[3] = s.initPos[3]
        -             else
        0                 initPos[1] = div(s.boxlength, 2) + offset * (2 * i - s.initParams - 1)
        0                 initPos[2] = div(s.boxlength, 2)
        0                 initPos[3] = div(s.boxlength, 2)
        -             end
        - 
        0             startIdx = beadsPerBox * (i - 1) + 1
        0             initBox!(s.pos, s.boxlength, beadsPerBox, initPos, startIdx)
        0         end
        -         
        0         s.length = totalBeads   # total length = length of each box * nboxes
        -     else
        0         error("Invalid string for s.initShape")
        -     end
        -     
        -     # head and tail beads
        0     s.pos[1][4] = 0
        0     s.pos[s.length][5] = 0
        -     
        0     return s
        - end
        - 
