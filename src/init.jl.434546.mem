        -         else
        0             push!(layeredSpecies, s)
        -         end
        0     end
        -     
        -     # Combine regular species with parent polymers for lattice allocation
        0     allLayeredSpecies = vcat(layeredSpecies, collect(polyParents))
        -     
        0     @assert length(allLayeredSpecies) <= 26 "Too many species"
