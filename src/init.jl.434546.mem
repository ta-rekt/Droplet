        - # initializes bead locations of a long Polymer in a doubly-linked list
        - function initSpecies!(p::Polymer)
        0     p.name = string("poly", p.id)
        0     p.pos = OrderedDict{Int32, Vector{Int32}}()
        -     
        0     initShape!(p)
        - 
        -     # head and tail beads
        0     p.head = 1
        - 
        -     # assign monomer pattern to pos[key][6] if monomers exist
        0     if p.monomers !== nothing
        0         _assignPattern!(p)
        -     end
        - 
        -     # key vector
        0     p.keys_vec = collect(keys(p.pos))
        - 
        0     p.tempVec = zeros(Int32, 3)
        0     p.bondVec = zeros(Int32, 3)
        0     p.moveVec = zeros(Int32, 3)
        0     p.newPosi = zeros(Int32, 3)
        0     p.newPosj = zeros(Int32, 3)
        0     p.moveTypes = zeros(Int32, 4)
        0     p.moveTypeProbs = [0,PKINK,0]
        0     p.nTypes = zeros(Int32, 3)
        0     p.hastingsFactor = 1.0
        -     
        -     # Initialize deltaHP for partner energy accumulation
        0     p.deltaHP = 0.0
        - 
        0     return p
        - end
