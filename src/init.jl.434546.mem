        - 
        -         # give each species a unique letter suffix
        0         s.name = string(s.name, "_", ALPHABET[i])
        0         l.speciesDir[s.id] = i
        - 
        -         # Populate lattice
        0         if typeof(s) <: AbstractBulkMonomer
        0             for j in 1:s.length
        0                 s.latS[s.pos[j][1], s.pos[j][2], s.pos[j][3]] = j
        0             end
        0         elseif typeof(s) <: AbstractPolymer && s.monomers !== nothing
