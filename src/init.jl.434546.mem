        - 
        - ############# Species initialization functions #############
        - 
        - ######## Generic #######
        - # MARK: -Generic
        - 
        - # initialize hamiltonian
        - function initHam!(s::AbstractSpecies)
        0     ham!(s)
        0     return s
        - end
        - 
        - # initial configurations
        - function initUniform!(pos::OrderedDict{Int32, Vector{Int32}}, boxlength::Int32, length::Int32)
        -     # sample uniformly randomly
        0     pos_idxs = sample(0:(boxlength^3-1), length, replace=false)
        -     
        0     for i in 1:length
        0         pos[i] = zeros(Int32, 6)
        0         mx = mod(pos_idxs[i], boxlength^2)
        -         
        0         pos[i][1] = div(pos_idxs[i], boxlength^2) + 1 # x coordinate
        0         pos[i][2] = div(mx, boxlength) + 1            # y coordinate
        0         pos[i][3] = mod(mx, boxlength) + 1            # z coordinate
        0         pos[i][4] = i - 1
        0         pos[i][5] = i + 1
        -         # pos[i][6] = intIdx, assigned later by initMonomers!
        0     end
        - 
        0     return pos
        - end
        - 
        - function initLine!(pos::OrderedDict{Int32, Vector{Int32}}, 
        -                    initPos::Union{Nothing, Vector{Int32}}, 
        -                    boxlength::Int32,
        -                    length::Int32)
        - 
        -     # line from center of one face to the other along x axis
        0     for i in 1:length
        0         pos[i] = zeros(Int32, 6)
        0         pos[i][1] = initPos === nothing ? i : i + initPos[1] - 1
        0         pos[i][2] = initPos === nothing ? div(boxlength, 2) : initPos[2]
        0         pos[i][3] = initPos === nothing ? div(boxlength, 2) : initPos[3]
        0         pos[i][4] = i - 1
        0         pos[i][5] = i + 1
        -         # pos[i][6] = intIdx, assigned later by initMonomers!
        0     end
        - 
        0     return pos
        - end
        - 
        - function initBox!(pos::OrderedDict{Int32, Vector{Int32}}, 
        -                   latticelength::Int32,
        -                   length::Int32,
        -                   startPos::Union{Nothing, Vector{Int32}},
        -                   newIndex::Int32 = Int32(1))
        - 
        -     # filled box shape
        -     idx = newIndex
        0     box_side = ceil(Int32, length^(1/3))
        0     offset = Int32(div(box_side, 2))
        0     clippedPos = zeros(Int32, 3)
        0     rawPos = zeros(Int32, 3)
        -     
        0     for x in 0:(box_side-1)
        0         for y in 0:(box_side-1)
        0             for z in 0:(box_side-1)
        0                 if idx >= length + newIndex
        -                     break
        -                 end
        - 
        0                 pos[idx] = zeros(Int32, 6)
        0                 rawPos = [startPos[1] + Int32(x) - offset,
        -                           startPos[2] + Int32(y) - offset,
        -                           startPos[3] + Int32(z) - offset]
        0                 boxmod!(rawPos, clippedPos, Int32(1), latticelength)
        - 
        0                 pos[idx][1] = clippedPos[1]
        0                 pos[idx][2] = clippedPos[2]
        0                 pos[idx][3] = clippedPos[3]
        0                 pos[idx][4] = idx - 1
        0                 pos[idx][5] = idx + 1
        -                 # pos[idx][6] = intIdx, assigned later
        0                 idx += 1
        0             end
        0             if idx >= length + newIndex
        -                 break
        -             end
        0         end
        0         if idx >= length + newIndex
        -             break
        -         end
        0     end
        - end
        - 
        - # Convenience method that converts Int64 to Int32
        - function initBox!(pos::OrderedDict{Int32, Vector{Int32}}, 
        -                   latticelength::Int32,
        -                   length::Int32,
        -                   startPos::Union{Nothing, Vector{Int32}},
        -                   newIndex::Int64)
        -     initBox!(pos, latticelength, length, startPos, Int32(newIndex))
        - end
        - 
        - function initSphere!(pos::OrderedDict{Int32, Vector{Int32}},
        -                      initPos::Vector{Int32},
        -                      boxlength::Int32,
        -                      radius::Int32)
        -     
        -     # Validate that sphere doesn't cross periodic boundaries
        -     center = initPos
        0     if any(center .- radius .< 1) || any(center .+ radius .> boxlength)
        0         error("Sphere with center at $center and radius $radius crosses box boundaries (boxlength=$boxlength)")
        -     end
        -     
        -     # Generate sphere by checking distance from center
        -     idx = Int32(1)
        -     
        -     # Iterate over bounding box around sphere
        0     for x in (center[1] - radius):(center[1] + radius)
        0         for y in (center[2] - radius):(center[2] + radius)
        0             for z in (center[3] - radius):(center[3] + radius)
        -                 # Calculate distance from center
        0                 dx = x - center[1]
        0                 dy = y - center[2]
        0                 dz = z - center[3]
        0                 dist = sqrt(Float64(dx*dx + dy*dy + dz*dz))
        -                 
        -                 # Include point if within radius
        0                 if dist <= radius
        0                     pos[idx] = zeros(Int32, 6)
        0                     pos[idx][1] = x
        0                     pos[idx][2] = y
        0                     pos[idx][3] = z
        0                     pos[idx][4] = idx - 1
        0                     pos[idx][5] = idx + 1
        -                     # pos[idx][6] = intIdx, assigned later
        0                     idx += 1
        -                 end
        0             end
        0         end
        0     end
        -     
        -     # Actual number of beads may differ slightly from theoretical volume
        0     actual_length = idx - 1
        -     
        0     return pos, actual_length
        - end
        - 
        - # populate the set of movable particles of a species
        - function initMovableSet!(s::AbstractSpecies)
        -     for i in collect(keys(s.pos))
        -         nns = nn(s, s.pos[i][range(1,3)])
        -         if nns < 6
        -             push!(s.movableIdxs, i)
        -         end
        -     end
        - 
        -     return s
        - end
