        -     # initialize ghost species
        0     gs = Species(;)
        0     gs.latS = view(l.lat, 1, :, :, :)
        0     gs.boxlength = l.boxlength
        0     initSpecies!(gs)
        - 
        -     # initialize each layered species (regular species + parent polymers)
        0     for (i, s) in enumerate(allLayeredSpecies)
        -         
        -         # give species s a view on its lattice sites, and on the ghost species
        0         s.latS = view(l.lat, i + 1, :, :, :)
        0         s.ghost = gs
        0         s.boxlength = l.boxlength
