        - # returns the center of mass of a species
        - export centerMass
        - function centerMass(s::Species)
   576000     cm = zeros(3)
        - 
        -     # compute average of all positions in pos
        0     for i in eachindex(s.pos)
144000160         cm = cm .+ view(s.pos[i], 1:3)
        0     end
        - 
   576000     return cm ./ s.length
        - end
        - 
        - # radius of gyration, mean squared distance btw each bead and
        - # the center of mass
        - export radius
        - function radius(s::Species)
        0     cm = centerMass(s)
        -     rg2 = 0
        - 
        0     for i in eachindex(s.pos)
        0         rg2 += ((cm[1] .- s.pos[i][1])^2
        -              + (cm[2] .- s.pos[i][2])^2
        -              + (cm[3] .- s.pos[i][3])^2)
        0     end
        - 
        0     return sqrt(rg2 / s.length)
        - end
        - 
        - # gyration radius of a line
        - export radiusLine
        - function radiusLine(length)
        0     n = div(length, 2)
        0     return sqrt((n - 1) / 2)
        - end
        - 
        - # gyration radius of a sphere
        - export radiusSphere
        - function radiusSphere(length)
        0     r = (3*length/(4*pi))^(1/3)
        0     return sqrt((r - 1) / 2)
        - end
