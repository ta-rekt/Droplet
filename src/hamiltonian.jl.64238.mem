        - # Hamiltonian of a polymer
        - export hamPoly!
        - function hamPoly!(s::Species)
        - 
        0     s.ham = 0
        -     nnn = 0                # number of nearest neighbors
        0     key = s.head           # initial bead
      160     pos = s.pos[key][1:3]  # initial posiion
        - 
        0     for i in 1:s.length
        0         nnn += nn(s, pos)
        0         key = s.pos[key][5]    # next bead
        - 
        0         if key != 0
     4960             pos = s.pos[key][1:3]  # next position
        -         end
        0     end
        - 
        0     @assert key == 0 begin
        0         "Tail is not N'th bead"
        -     end
        - 
        -     # @show nnn
        - 
       64     s.ham = - (s.chemPot + s.intPot) * s.length + s.intPot * nnn
        - 
        0     return s
        - end
