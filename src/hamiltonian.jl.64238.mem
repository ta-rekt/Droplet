        - # Energy increment of a proposed move. Requires proposeMove! to be called
        - # which sets moveType and newPosi/j. 
        - export deltaHamPoly!
        - function deltaHamPoly!(s::Species)
        - 
        0     @assert s.moveType == 1 || s.moveType == 2 || s.moveType == 3 begin
        0         "s.moveType must be either 1, 2, or 3"
        -     end
        - 
        0     s.deltaH = 0
        -     # @show nn(s, s.newPosi)
        -     # @show nn(s, s.newPosj)
        - 
        -     # bond addition
        0     if s.moveType == 1
        -         # add 4 = 2 (canceled by 1st term) + 2 (move hasn't been made yet)
    23856         s.deltaH = (- 2 * (s.chemPot + s.intPot) 
        -                     + s.intPot * (4 + nn(s, s.newPosi) + nn(s, s.newPosj)))
        - 
        -     # kink
        0     elseif s.moveType == 2
        - 
        0         if s.newPosi == s.bprev 
   930080             s.deltaH = s.intPot * (nn(s, s.newPosj) - nn(s, s.bi))
        0         elseif s.newPosj == s.bnext
   928176             s.deltaH = s.intPot * (nn(s, s.newPosi) - nn(s, s.bj))
        -         else
        0             error("Move is not a kink")
        -         end
        - 
        -     # bond removal  
        0     elseif s.moveType == 3 
  1182992         s.deltaH = (2 * (s.chemPot + s.intPot)  
        -                     - s.intPot * (2 + nn(s, s.bi) + nn(s, s.bj)))
        -     end
        - 
        0     s.ham += s.deltaH
        - 
        0     return s
        - end
        - 
        - # Number of nearest neighbors at a given position
        - export nn
        - function nn(s::Species, pos::Union{SubArray{Int32}, Vector{Int32}})
        -     n = 0
 12314240     adjPos = zeros(Int32, 3)
        - 
        0     for i in 1:3
        0         pos[i] += 1
        0         boxmod!(pos, adjPos, Int32(1), s.boxlength)
 59108352         n += s.latS[adjPos...]
        -         # @show adjPos
        -         # @show i, pos, n
        - 
        0         pos[i] -= 2
        0         boxmod!(pos, adjPos, Int32(1), s.boxlength)
 59108352         n += s.latS[adjPos...]
        -         # @show adjPos
        -         # @show i, pos, n
        - 
        0         pos[i] += 1
        0     end
        - 
        0     return n
        - end
