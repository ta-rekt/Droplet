        - # Translates a particle to a new position set by b.newPos
        - function makeMove!(b::BulkMonomer)
        -     
        -     # update lattice sites
        0     b.latS[b.bi[1], b.bi[2], b.bi[3]] = 0
    41456     b.latS[b.newPos[1], b.newPos[2], b.newPos[3]] = b.moveIdx
