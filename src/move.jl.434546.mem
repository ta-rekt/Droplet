        - # executes a move on polymermer s inside lattice l at position p.moveIdx, of type
        - # moveType (add, remove or kink) sampled according to the metropolis algorithm
        - function move!(p::Polymer)
        - 
        -     # sample a bond at random along the chain
        0     p.moveIdx = rand(1:p.length - 1)
        -     
        -     # find coordinates and keys of selected bond and adjacent beads
        0     identifyBond!(p)
        -     
        -     # don't move if last bead was selected
        0     if p.kj != 0
        -         
        -         # Reject if bond spans type boundary (heterogeneous polymers only)
        0         if p.patternTails !== nothing && !isempty(p.patternTails)
        0             if p.pos[p.ki][6] != p.pos[p.kj][6]
        0                 return false
        -             end
        -         end
        -         
        -         # sample a move according to proposition probabilities
        0         proposeMove!(p)
        -         
        -         # Validate pattern swap is possible for non-base types
        0         if p.patternTails !== nothing && !isempty(p.patternTails)
        0             currentIntIdx = p.pos[p.ki][6]
        0             if currentIntIdx != p.baseIntIdx && haskey(p.patternTails, currentIntIdx)
        0                 tailKey = p.patternTails[currentIntIdx]
        0                 prevTailKey = p.pos[tailKey][4]
        -                 
        0                 if p.moveType == 1  # addBond: pattern shrinks at tail
        -                     # Need at least 4 beads in pattern (2 will be swapped)
        0                     newTailKey = p.pos[prevTailKey][4]
        0                     if newTailKey == 0 || p.pos[newTailKey][6] != currentIntIdx
        0                         return false  # Pattern too small
        -                     end
        -                     
        -                     # CRITICAL: Reject if bond includes tail or prevTail
        -                     # Adding at tail/prevTail would create fragmentation
        0                     if p.ki == tailKey || p.kj == tailKey || p.ki == prevTailKey || p.kj == prevTailKey
        0                         return false  # Cannot add at tail position
        -                     end
        -                     
        0                 elseif p.moveType == 3  # removeBond: need base-type beads after tail
        0                     nextAfterTail = p.pos[tailKey][5]
        0                     nextNextAfterTail = nextAfterTail == 0 ? Int32(0) : p.pos[nextAfterTail][5]
        0                     if nextAfterTail == 0 || p.pos[nextAfterTail][6] != p.baseIntIdx ||
        -                        nextNextAfterTail == 0 || p.pos[nextNextAfterTail][6] != p.baseIntIdx
        0                         return false  # Insufficient base-type beads
        -                     end
        -                 end
        -             end
        -         end
        -         
        -         # check for max length constraint and overlap
        -         # Note: addBond (moveType==1) adds 2 beads, so reject when length >= maxlength - 1
        0         if !overlap(p) && !(p.moveType == 1 && p.length >= p.maxlength - 1)
        -             
        -             # accept move with metropolis criterion
        0             if acceptMove(p)
        -                 
        0                 makeMove!(p)
        0                 p.length = length(keys(p.pos))   # TODO: refactor for speed
        0                 return true
        -             end
        -         end
        -     end
        - 
        0     return false
        - end
