        - # Calls the appropriate operation (add, kink or remove) to execute a move
        - function makeMove!(p::Polymer)
        - 
        0     @assert p.moveType == 1 || p.moveType == 2 || p.moveType == 3 begin
        0         "p.moveType must be either 1, 2, or 3"
        -     end
        - 
        -     # bond addition
        0     if p.moveType == 1
        0         addBond!(p)
        - 
        -     # kink
        0     elseif p.moveType == 2
        0         kinkBond!(p)
        - 
        -     # bond removal  
        0     elseif p.moveType == 3 
        0         removeBond!(p)
        -     end
        - 
        0     return p
        - end
