        - function identifyBond!(b::FastBulkMonomer)
        -     b.moveIdx = b.latS[b.bi[1], b.bi[2], b.bi[3]]
        -     b.moveIdxNew = b.latS[b.newPos[1], b.newPos[2], b.newPos[3]]
        - 
        -     return b
