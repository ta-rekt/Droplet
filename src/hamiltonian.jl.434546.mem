        - ham!(m::PolyMonomer) = ham!(m.poly)
        - deltaHam!(m::PolyMonomer) = deltaHam!(m.poly)
        - 
        - ############# BulkMonomer energy functions #############
        - # MARK: -BulkMonomer
        - 
        - # Hamiltonian of a dilute species in the bulkMonomer
        - function ham!(b::AbstractBulkMonomer)
        -     
        -     # chemical potential
        0     b.ham = - b.chemPot * b.length
        - 
        -     # interaction potentials (including self)
        0     for (sp, idx) in b.intSpecies
        -         nnp_ = 0.0   # number of nearest partners
        0         selfFactor = b.intIdx == idx ? 0.5 : 1.0
        - 
        0         for i in 1:b.length
        0             pos = b.pos[i][range(1, 3)]
        0             nnp_ += nnp(b, sp, pos)
        0         end
        -         
        0         b.ham += b.intMat[b.intIdx, idx] * nnp_ * selfFactor
        0     end
        - 
        0     return b
        - end
        - 
