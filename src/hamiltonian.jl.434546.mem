  1851248             if sp isa PolyMonomer && !(sp.poly in seen_polys)
        0                 sp.poly.deltaHP = 0.0
   154272                 push!(seen_polys, sp.poly)
        0             elseif !(sp isa PolyMonomer)
        0                 sp.deltaHP = 0.0
        -             end
  3702528         end
        -     end
        - 
        -     # energy increment from cross-interactions with each partner
        0     if !isnothing(b.intMat)
  4319616         for (sp, idx) in b.intSpecies
  4011072             energy_change = (b.intMat[b.intIdx, idx] 
        -                        * ((nnp(b, sp, b.newPos) - nnp(b, sp, b.bi))
        -                        - Int(b.intIdx == idx))) # subtract 1 in self-interaction
        0             setDeltaHP(sp, energy_change)
  4011072             b.deltaH += energy_change
