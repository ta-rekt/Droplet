        - 
        - export ham!, deltaHam!
        - 
        - ############# Polymer Energy functions #############
        - # MARK: -Polymer
        - 
        - # Hamiltonian of a polymer
        - function ham!(p::Polymer)
        0     p.ham = 0
        -     totalChemEnergy = 0.0
        -     totalIntEnergy = 0.0
        - 
        0     key = p.head
        -     
        -     # Get any monomer to check intMat exists (all share same matrix)
        0     refMonomer = first(values(p.monomers))
        0     @assert !isnothing(refMonomer.intMat) "No interaction matrix!"
        - 
        0     for i in 1:p.length
        0         pos = p.pos[key][1:3]
        0         m = p.monomers[p.pos[key][6]]  # Dictionary lookup by intIdx
        -         
        -         # Chemical potential contribution
        0         totalChemEnergy -= m.chemPot
        -         
        0         for (sp, idx) in m.intSpecies    
        -             # Interaction energy: count neighbors
        0             nnp_ = nnp(m, sp, pos)
        -             
        -             # For self-interactions, divide by 2 to avoid double-counting bonds
        -             # For cross-interactions, count all neighbors
        0             if m.intIdx == idx
        0                 totalIntEnergy += m.intMat[m.intIdx, idx] * nnp_ / 2.0
        -             else
        0                 totalIntEnergy += m.intMat[m.intIdx, idx] * nnp_
        -             end
        0         end
        - 
        0         key = p.pos[key][5]
        0     end
        - 
        0     @assert key == 0 "Tail is not N'th bead"
        - 
        0     p.ham = totalChemEnergy + totalIntEnergy
        - 
        0     return p
        - end
