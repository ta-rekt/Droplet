        -     # don't move if last bead was selected
        0     if s.kj != 0
        -         
        -         # compute the possible move types around a bond
        0         moveTypes!(s)
        -         
        -         # sample a move according to proposition probabilities
        0         proposeMove!(s)
        -         
        -         # check for max length constraint and overlap
        0         if !overlap(s) && !(s.moveType == 1 && s.length == s.maxlength)
        -             
        -             # accept move with metropolis criterion
        0             if acceptMove(s)
        -                 
        0                 makeMove!(s)
        0                 s.length = length(keys(s.pos))   # TODO: refactor for speed
        -                 moveExecuted = true
        -             end
        -         end
        -     end
        - 
        0     return moveExecuted
        - end
