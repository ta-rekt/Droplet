        - const PKINK = 0.8
        - 
        - # initializes bead locations of a long polymer in a doubly-linked list
        - export initPoly!
        - function initPoly!(s::Species)
      352     s.name = string("poly", s.id)
        0     s.pos = OrderedDict{Int32, Vector{Int32}}()
      160     v = zeros(Int32, 3)
        - 
        -     # line from center of one face to the other along x axis
        0     for i in 1:s.boxlength
        0         v[1] = i
        0         v[2] = s.initPos === nothing ? div(s.boxlength, 2) : s.initPos[2]
        0         v[3] = s.initPos === nothing ? div(s.boxlength, 2) : s.initPos[3]
     5248         s.pos[i] = [v..., i-1, i+1]  # last two indices are pointers to prev and next bead
        0     end
        - 
        -     # head and tail beads
        0     s.head = 1
        0     s.pos[s.head][4] = 0
        0     s.pos[s.boxlength][5] = 0
        - 
      160     s.bondVec = zeros(Int32, 3)
      160     s.moveVec = zeros(Int32, 3)
      160     s.newPosi = zeros(Int32, 3)
      160     s.newPosj = zeros(Int32, 3)
      160     s.moveTypes = zeros(Int32, 4)
      160     s.moveTypeProbs = [0,PKINK,0]
      256     s.nTypes = zeros(Int32, 3)
        - 
        0     return s
        - end
        - 
        - # initialize hamiltonian
        - export initHamPoly!
        - function initHamPoly!(s::Species)
        -     hamPoly!(s)
        - 
        -     return s
        - end
        - 
        - # initializes beads positioned uniformly randomly (dilute and well-mixed)
        - export initDilute!
        - function initDilute!(s::Species)
        - 
      352     s.name = string("dilute", s.id)
        0     s.pos = OrderedDict{Int32, Vector{Int32}}()
        0     s.head = 1
        - 
        0     for i in 1:s.length
        0         s.pos[i] = rand(1:s.boxlength, 5)
        0         s.pos[i][4] = i-1
        0         s.pos[i][5] = i+1
        0     end
        - 
        0     s.pos[1][4] = 0
        0     s.pos[s.length][5] = 0
        - 
        0     return s
        - end
        - 
        - # initializes lattice sites of each species from their bead locations
        - export initLattice!
        - function initLattice!(l::Lattice, ss::Vector{Species})
        - 
        0     l.nspecies = length(ss)   # update number of species
        0     l.lat = zeros((l.nspecies, l.boxlength, l.boxlength, l.boxlength))
      160     l.speciesDir = Dict{Int, Int}()
        - 
        -     # fill out lattice sites for each species
        0     for (i, s) in enumerate(ss)
        0         l.speciesDir[s.id] = i
        - 
        -         # give species s a view on its lattice sites
      128         s.latS = view(l.lat, i, :, :, :)
        - 
        0         for j in 1:s.length
        0             v = view(s.pos[j], 1:3)
        0             s.latS[v...] = 1
        0         end
        0     end
        - 
        0     return l
        - end
