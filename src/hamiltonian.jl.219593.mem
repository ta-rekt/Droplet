        - # Hamiltonian of a polymer
        - export hamPoly!
        - function hamPoly!(s::Species)
        - 
        0     s.ham = 0
        -     nnn = 0                # number of nearest neighbors
        0     key = s.head           # initial bead
    96480     pos = s.pos[key][RANGE_1_3]  # initial posiion
        - 
        0     for i in 1:s.length
    54832         nnn += nn(s, pos)
        0         key = s.pos[key][5]    # next bead
        - 
        0         if key != 0
 20841760             pos = s.pos[key][RANGE_1_3]  # next position
        -         end
        0     end
        - 
        0     @assert key == 0 begin
        0         "Tail is not N'th bead"
        -     end
        - 
    77088     s.ham = - (s.chemPot + s.intPot) * s.length + s.intPot * nnn
        - 
        0     return s
        - end
        - 
        - # Energy increment of a proposed move. Requires proposeMove! to be called
        - # which sets moveType and newPosi/j. 
        - export deltaHamPoly!
        - function deltaHamPoly!(s::Species)
        - 
        0     @assert s.moveType == 1 || s.moveType == 2 || s.moveType == 3 begin
        0         "s.moveType must be either 1, 2, or 3"
        -     end
        - 
        0     s.deltaH = 0
        -     # @show nn(s, s.newPosi)
        -     # @show nn(s, s.newPosj)
        - 
        -     # bond addition
        0     if s.moveType == 1
  1043760         s.deltaH = (- 2 * (s.chemPot + s.intPot) 
        -                     + s.intPot * (2*(nn(s, s.newPosi) + nn(s, s.newPosj)) + 2))
        - 
        -     # kink
        0     elseif s.moveType == 2
        - 
        0         if s.newPosi == s.bprev 
  1254640             s.deltaH = 2 * s.intPot * (nn(s, s.newPosj) - nn(s, s.bi))
        0         elseif s.newPosj == s.bnext
  1243440             s.deltaH = 2 * s.intPot * (nn(s, s.newPosi) - nn(s, s.bj))
        -         else
        0             error("Move is not a kink")
        -         end
        - 
        -     # bond removal  
        0     elseif s.moveType == 3 
    69936         s.deltaH = (2 * (s.chemPot + s.intPot)  
        -                     - s.intPot * (2*(nn(s, s.bi) + nn(s, s.bj)) - 2))
        -     end
        - 
        0     s.ham += s.deltaH
        - 
        0     return s
        - end
        - 
        - # Number of nearest neighbors at a given position
        - export nn
        - function nn(s::Species, pos::Union{SubArray{Int32}, Vector{Int32}})
        -     n = 0
        - 
        0     for i in 1:3
        0         pos[i] += 1
        0         boxmod!(pos, s.tempVec, Int32(1), s.boxlength)
        0         n += s.latS[s.tempVec[1], s.tempVec[2], s.tempVec[3]]
        -         # @show s.tempVec
        -         # @show i, pos, n
        - 
        0         pos[i] -= 2
        0         boxmod!(pos, s.tempVec, Int32(1), s.boxlength)
        0         n += s.latS[s.tempVec[1], s.tempVec[2], s.tempVec[3]]
        -         # @show s.tempVec
        -         # @show i, pos, n
        - 
        0         pos[i] += 1
        0     end
        - 
        0     return n
        - end
