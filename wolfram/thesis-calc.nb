Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"m", ",", "t", ",", "\[Theta]", ",", "p", ",", "v"}], "]"}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Negative", " ", "log"}], "-", "likelihood"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nll", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "-", 
         RowBox[{
          RowBox[{"p", "[", "\[Theta]", "]"}], " ", "t"}]}], ")"}], "^", 
       "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"v", "[", "\[Theta]", "]"}], " ", "t"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"v", "[", "\[Theta]", "]"}], " ", "t"}], "]"}]}]}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gaussian", " ", "distribution", " ", "of", " ", "m"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dist", "=", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "\[Theta]", "]"}], " ", "t"}], ",", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"v", "[", "\[Theta]", "]"}], " ", "t"}], "]"}]}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fisher", " ", "information", " ", "from"}], "<", 
    RowBox[{
     RowBox[{"d", "^", "2"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "log"}], " ", "P"}], ")"}], "/", "d"}], " ", 
     RowBox[{"theta", "^", "2"}]}], ">"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FI", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Expectation", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"nll", ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"m", "\[Distributed]", "dist"}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"t", ">", "0"}], "&&", 
        RowBox[{
         RowBox[{"v", "[", "\[Theta]", "]"}], ">", "0"}]}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", "FI"}], "Input",
