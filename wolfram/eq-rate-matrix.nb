Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Detailed", "-", 
    RowBox[{
     RowBox[{"balance", "/", "ratio"}], " ", "equations"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"eqs1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "*", 
         RowBox[{"kbOff", "/", "kuOff"}]}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", 
          RowBox[{"(", 
           RowBox[{"eBI", "-", "eUI"}], ")"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"kOnb", "/", "kOffb"}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", 
          RowBox[{"(", 
           RowBox[{"eBA", "-", "eBI"}], ")"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"c", "*", 
         RowBox[{"kbOn", "/", "kuOn"}]}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", 
          RowBox[{"(", 
           RowBox[{"eBA", "-", "eUA"}], ")"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"kOnu", "/", "kOffu"}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", 
          RowBox[{"(", 
           RowBox[{"eUI", "-", "eUA"}], ")"}]}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Linear", " ", 
     RowBox[{"(", 
      RowBox[{"flux", "-", "balance"}], ")"}], " ", "equations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqs2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"c", "*", "kbOff", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eUI"}], "]"}]}], "+", 
         RowBox[{"kOffb", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eBA"}], "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", "*", "kbOff"}], "+", "kOffb"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], "*", "eBI"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "*", "kbOn", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eUA"}], "]"}]}], "+", 
         RowBox[{"kbOn", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eBI"}], "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", "*", "kbOn"}], "+", "kOnb"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], "*", "eBA"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"kuOn", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eUI"}], "]"}]}], "+", 
         RowBox[{"kuOn", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eBA"}], "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", "*", "kOnu"}], "+", "kuOn"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], "*", "eUA"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"kuOff", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eUA"}], "]"}]}], "+", 
         RowBox[{"kuOff", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Beta]"}], "*", "eBI"}], "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"kOffu", "+", "kuOff"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], "*", "eUI"}], "]"}]}]}], ",", 
       RowBox[{"kuOff", "==", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"All", " ", "equations", " ", "together"}], ",", 
     RowBox[{"if", " ", "you", " ", "want"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"eqs1", ",", "eqs2"}], "]"}]}], ";"}], "\n"}]}]], "Input",
